  "client_script": "frappe.web_form.after_load = () => {\r\n    const esc = (v) => frappe.utils.escape_html(v == null ? \"\" : String(v));\r\n    const money = (n) =>\r\n        Number(n || 0).toLocaleString(\"en-IN\", {\r\n            minimumFractionDigits: 2,\r\n            maximumFractionDigits: 2,\r\n        });\r\n\r\n    // Entry name from the URL, e.g. /my-ledger/ACC-GLE-2026-05387\r\n    const currentEntry = decodeURIComponent(\r\n        window.location.pathname.split(\"/\")[2] || \"\"\r\n    );\r\n\r\n    // Not on an entry page (e.g. the list route): do nothing.\r\n    if (!currentEntry) {\r\n        return;\r\n    }\r\n\r\n    function place(html) {\r\n        $(\"#ledger-entry\").remove();\r\n        const $body = $(\".web-form-body\").first();\r\n        if ($body.length) {\r\n            $body.append(html);\r\n        } else {\r\n            $(\".web-form-container, .page_content\").first().after(html);\r\n        }\r\n    }\r\n\r\n    function render(data) {\r\n        const e = (data.entries || [])[0];\r\n\r\n        if (!e) {\r\n            place(`<div id=\"ledger-entry\" class=\"text-muted\" style=\"margin-top:30px;\">\r\n                       Entry ${esc(currentEntry)} was not found in your ledger.\r\n                   </div>`);\r\n            return;\r\n        }\r\n\r\n        const cur = e.account_currency || \"\";\r\n        const fields = [\r\n            [\"Entry\", e.name],\r\n            [\"Posting Date\", e.posting_date],\r\n            [data.party_type, data.party],   // label becomes Supplier or Customer\r\n            [\"Account\", e.account],\r\n            [\"Voucher Type\", e.voucher_type],\r\n            [\"Voucher No\", e.voucher_no],\r\n            [\"Against\", e.against],\r\n            [\"Debit\", e.debit ? money(e.debit) : \"0.00\"],\r\n            [\"Credit\", e.credit ? money(e.credit) : \"0.00\"],\r\n            [`Debit (${cur})`, money(e.debit_in_account_currency)],\r\n            [`Credit (${cur})`, money(e.credit_in_account_currency)],\r\n            [\"Remarks\", e.remarks],\r\n        ];\r\n\r\n        const rows = fields\r\n            .map(\r\n                ([label, value]) => `\r\n                <tr>\r\n                    <th style=\"width:30%;\">${esc(label)}</th>\r\n                    <td>${esc(value)}</td>\r\n                </tr>`\r\n            )\r\n            .join(\"\");\r\n\r\n        place(`\r\n            <div id=\"ledger-entry\" style=\"margin-top:30px;\">\r\n                <h4>Ledger Entry: ${esc(e.name)}</h4>\r\n                <div style=\"overflow-x:auto;\">\r\n                    <table class=\"table table-bordered table-sm\">\r\n                        <tbody>${rows}</tbody>\r\n                    </table>\r\n                </div>\r\n            </div>`);\r\n    }\r\n\r\n    frappe.call({\r\n        method: \"get_portal_ledger\",\r\n        args: { entry: currentEntry },\r\n        callback: (r) => {\r\n            if (!r.message) {\r\n                frappe.msgprint(__(\"Unable to load your ledger.\"));\r\n                return;\r\n            }\r\n            render(r.message);\r\n        },\r\n        error: () => {\r\n            frappe.msgprint(__(\"Failed to load this entry.\"));\r\n        },\r\n    });\r\n};",
