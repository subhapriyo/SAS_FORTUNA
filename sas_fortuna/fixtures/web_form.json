  "client_script": "frappe.web_form.after_load = () => {\r\n    // Determine the requested ledger type from the Web Form.\r\n    // For a Customer ledger, use \"Customer\"; for a Supplier ledger,\r\n    // use \"Supplier\".\r\n    const partyType = frappe.web_form.get_value(\"party_type\");\r\n\r\n    // Require a valid party type before requesting ledger data.\r\n    if (![\"Customer\", \"Supplier\"].includes(partyType)) {\r\n        frappe.msgprint(\r\n            __(\"Please select Customer or Supplier.\")\r\n        );\r\n        return;\r\n    }\r\n\r\n    // Fetch ledger data from the server.\r\n    // The server verifies that the requested party belongs to the\r\n    // currently logged-in portal user.\r\n    frappe.call({\r\n        method: \"get_portal_ledger\",\r\n        args: {\r\n            party_type: partyType\r\n        },\r\n        callback: function (r) {\r\n            const data = r.message;\r\n\r\n            // Stop if the server returned no ledger context.\r\n            if (!data) {\r\n                frappe.msgprint(\r\n                    __(\"Unable to load your ledger.\")\r\n                );\r\n                return;\r\n            }\r\n\r\n            // The server-resolved party is authoritative.\r\n            // Do not use a client-supplied party value here.\r\n            console.log(\"Ledger Party:\", data.party);\r\n            console.log(\"Party Type:\", data.party_type);\r\n            console.log(\"Entries:\", data.entries);\r\n        }\r\n    });\r\n};\r\n",
