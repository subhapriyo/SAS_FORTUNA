  "client_script": "frappe.web_form.on(\"gstin\", (field, value) => {\n\tif (!value) return;\n\n\tconst GSTIN_REGEX = /^\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;\n\tconst gstin = value.trim().toUpperCase();\n\n\tif (!GSTIN_REGEX.test(gstin)) {\n\t\tfrappe.msgprint(\"Please enter a valid GSTIN (e.g., 22AAAAA0000A1Z5).\");\n\t} else if (gstin !== value) {\n\t\tfrappe.web_form.set_value(\"gstin\", gstin);\n\t}\n});\n\nfrappe.web_form.on(\"pan\", (field, value) => {\n\tif (!value) return;\n\n\tconst PAN_REGEX = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;\n\tconst pan = value.trim().toUpperCase();\n\n\tif (!PAN_REGEX.test(pan)) {\n\t\tfrappe.msgprint(\"Please enter a valid PAN (e.g., AAAAA0000A).\");\n\t} else if (pan !== value) {\n\t\tfrappe.web_form.set_value(\"pan\", pan);\n\t}\n});\n\nfrappe.web_form.validate = () => {\n\tconst GSTIN_REGEX = /^\\d{2}[A-Z]{5}\\d{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/;\n\tconst PAN_REGEX = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;\n\n\tconst gstin = frappe.web_form.get_value(\"gstin\");\n\tconst pan = frappe.web_form.get_value(\"pan\");\n\n\tif (gstin && gstin.trim() !== \"\") {\n\t\tif (!GSTIN_REGEX.test(gstin.trim().toUpperCase())) {\n\t\t\tfrappe.msgprint(\"Please enter a valid GSTIN before submitting.\");\n\t\t\treturn false;\n\t\t}\n\t}\n\n\tif (pan && pan.trim() !== \"\") {\n\t\tif (!PAN_REGEX.test(pan.trim().toUpperCase())) {\n\t\t\tfrappe.msgprint(\"Please enter a valid PAN before submitting.\");\n\t\t\treturn false;\n\t\t}\n\t}\n\n\treturn true;\n};\n",
